{
  "name": "condotel-phase7-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Phase 7 backend foundation for the Condotel NFC System with Payment",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "migrate": "node src/db/migrate.js",
