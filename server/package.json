{
  "name": "condotel-phase7-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Phase 7 backend foundation for the Condotel NFC System with Payment",
  "scripts": {
    "dev": "nodemon --watch src --ext js,mjs,cjs,json src/server.js",
    "start": "node src/server.js",
    "migrate": "node src/db/migrate.js",
    "seed": "node src/db/seed.js",
    "db:verify": "node src/db/verify.js",
    "data:migrate:review": "node src/dataMigration/reviewLegacyExport.js",
    "data:migrate:backup": "node src/dataMigration/backupDatabase.js",
    "data:migrate:import": "node src/dataMigration/importLegacyData.js",
    "data:migrate:verify": "node src/dataMigration/verifyDataMigration.js",
    "phase7:verify": "node src/handover/verifyPhase7.js",
    "phase7:smoke": "node scripts/phase7-smoke.js",
    "phase7:handover": "node src/handover/generateHandoverReport.js",
    "test:guests": "node --test test/guests.test.js",
    "test:rooms": "node --test test/rooms.test.js",
    "test:reservations": "node --test test/reservations-charges.test.js",
    "test:data-migration": "node --test test/data-migration.test.js",
    "test:phase7-handover": "node --test test/phase7-handover.test.js",
    "test": "node --test"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "better-sqlite3": "^12.2.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "nodemon": "^3.1.10"
  }
}
